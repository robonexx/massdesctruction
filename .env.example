APP_NAME=massdestruction

# Server-only admin credentials. Never prefix secrets with NEXT_PUBLIC_.
MD_ADMIN_USER=choose-an-admin-name
MD_ADMIN_PASS=choose-a-long-password
MD_ADMIN_SESSION_SECRET=generate-a-separate-long-random-secret

# MongoDB Atlas connection. Add these values to every required Vercel environment.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/massdestruction?retryWrites=true&w=majority
MONGODB_DB=massdestruction
